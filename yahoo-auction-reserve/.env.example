# PostgreSQL
DATABASE_URL=postgresql://yar:yar@localhost:5432/yar

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# セッションCookie暗号化用マスターキー(32byte を base64 で。本番は KMS / Docker secret で注入)
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_ENCRYPTION_KEY=

# Webアプリのセッション署名キー(同上)
AUTH_SECRET=

# 通知メール (未設定ならコンソール出力にフォールバック)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# Telegram 通知 (未設定なら Telegram 経路は丸ごとスキップされ、メールとログだけになる)
# @BotFather で新規 Bot を作成して取得する。値はここに書かず .env にだけ入れる。
# ⚠️ getUpdates は 1 Bot 1 消費者。既存 Bot を使い回すと worker と旧消費者が
#    409 で奪い合い、増額の承認ボタンが無言で効かなくなる(新規 Bot を作る)。
TELEGRAM_BOT_TOKEN=

# Playwright: 環境に既存の Chromium がある場合のみ指定
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium
ALLOW_REGISTRATION=false
